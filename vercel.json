{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx drizzle-kit push --force && npx next build",
  "installCommand": "npm install",
  "crons": [
    { "path": "/api/cron/drop?secret=$CRON_SECRET", "schedule": "0 * * * *" },
    { "path": "/api/cron/verify?secret=$CRON_SECRET", "schedule": "5,35 * * * *" }
  ]
}
